    (47 "F.CrtYd" user) (48 "B.Fab" user) (49 "F.Fab" user)
  )
  (setup (pad_to_mask_clearance 0) (allow_missing_courtyard yes)
    (pcbplotparams (layerselection 0x000_ffff_ffff) (plot_on_all_layers_selection 0) (disableapertmacros no)
      (usegerberextensions no) (usegerberattributes yes) (usergerberadvancedattributes yes)
      (creategerberjobfile yes) (dashed_line_dash_ratio 12) (dashed_line_gap_ratio 3)
      (svgprecision 4) (plotframeref no) (viasonmask no) (mode 1) (useauxorigin no)
      (hpglpennumber 1) (hpglpenspeed 20) (hpglpendiameter 15)
      (pdf_front_fp_property_popups yes) (pdf_back_fp_property_popups yes)
      (dxfpolygonmode yes) (dxfimpunit 1) (dxfimptolerance 0.01)
      (gerbprec 4) (gerbprec 5) (subtractmaskfromsilk no) (outputformat 1)
      (layersubsequence enabled) (plotreference yes) (plotvalue yes) (plotfptext yes)
      (sketchpadsonfab no) (sketchpadsontop no) (sketchpadsbottom no) (hidefptextonfab no) (sketchpadlineweight 0.1)
      (sketchpadtext 0 "0") (plotothertext yes) (plotpadnumbers no) (padsontopthtinnerfabrication no)))
  (net 0 "") (net 1 "5V") (net 2 "GND") (net 3 "GPIO16") (net 4 "GPIO17") (net 5 "DIN")
